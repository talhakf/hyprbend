#!/bin/bash
# hyprbend - Automatic screen rotation and virtual keyboard
# for 2-in-1 laptops running Hyprland
#
# Detects laptop/tablet/tent mode via hinge sensor and:
# - Rotates screen based on accelerometer orientation
# - Rotates touch input to match
#
# Requires: hyprland, iio-sensor-proxy, bash

set -euo pipefail
# Disable job control so bash never prints "Done <pipeline>" async-job status
# when the backgrounded monitor-sensor is stopped on Ctrl-C/service restart.
set +m

# Source shared detection library
_HYPRBEND_LIB_DIR="${HYPRBEND_LIB_DIR:-/usr/lib/hyprbend}"
_HYPRBEND_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_HYPRBEND_LIB_DIR}/detect.sh" ]]; then
    # shellcheck source=hyprbend-detect.sh
    source "${_HYPRBEND_LIB_DIR}/detect.sh"
fi

# Subcommand dispatch: hyprbend check|fix|report
if [[ "${1:-}" =~ ^(check|fix|report)$ ]]; then
    _subcmd="${BASH_REMATCH[1]}"
    shift
    _BIN=""
    for candidate in \
        "${_HYPRBEND_BIN_DIR}/hyprbend-${_subcmd}" \
        "/usr/bin/hyprbend-${_subcmd}"; do
        if [[ -x "$candidate" ]]; then
            _BIN="$candidate"
            break
        fi
    done
    if [[ -z "$_BIN" ]]; then
        echo "[hyprbend] ERROR: hyprbend-${_subcmd} not found" >&2
        exit 1
    fi
    exec "$_BIN" "$@"
fi

# Physical reference anchors (deg)
CLOSED_ANGLE=0        # lid fully closed
TABLET_ANGLE=360      # lid folded fully back (single flat panel)

# Mode boundary (deg). The hinge channel reports the lid opening angle:
#   angle <  LAPTOP_TENT_BOUNDARY  -> laptop / normal use
#   angle >= LAPTOP_TENT_BOUNDARY  -> tent / tablet (lid folded back past flat)
LAPTOP_TENT_BOUNDARY=180
DEBOUNCE_DELAY=250    # milliseconds to wait before mode switch

# State
current_mode="unknown"
current_transform=""
monitor_sensor_pid=""

log() {
    echo "[hyprbend] $*" >&2
}

# Run a hyprctl command and tag any output with [hyprctl] for clean, attributed logs.
# Captures stdout+stderr; non-empty lines are logged, blank lines are dropped.
run_hyprctl() {
    local out line
    out=$("$@" 2>&1 || true)
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        log "[hyprctl] $line"
    done <<< "$out"
}

cleanup() {
    log "Shutting down..."
    stop_orientation_monitor
    if [[ -n "${TOUCH_DEVICE_NAME:-}" ]]; then
        run_hyprctl hyprctl eval "hl.device({ name = \"$TOUCH_DEVICE_NAME\", transform = 0 })"
    fi
    exit 0
}

trap cleanup SIGTERM SIGINT SIGHUP

# Auto-detect hinge IIO device
detect_hinge_device() {
    for dev in /sys/bus/iio/devices/iio:device*; do
        local name
        name=$(cat "$dev/name" 2>/dev/null || echo "")
        if [[ "$name" == "hinge" ]]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}

# Auto-detect the hinge/lid angle channel. The meaningful channel is the one
# labeled "hinge" (the lid opening angle, e.g. ~3 closed, ~106 at 90°, ~131 at
# tent). The "keyboard" channel on ISH sensors reports the flat keyboard base's
# angle (~0°) and never tracks the lid, so it must not be used for mode detection.
detect_hinge_angle_path() {
    local hinge_dev=$1
    for label_file in "$hinge_dev"/in_angl*_label; do
        local label
        label=$(cat "$label_file" 2>/dev/null || echo "")
        case "$label" in
            hinge|screen)
                echo "${label_file%_label}_raw"
                return 0
                ;;
        esac
    done
    # Degraded fallback: the "keyboard" channel (matches older/unlabeled sensors).
    for label_file in "$hinge_dev"/in_angl*_label; do
        local label
        label=$(cat "$label_file" 2>/dev/null || echo "")
        if [[ "$label" == "keyboard" ]]; then
            echo "${label_file%_label}_raw"
            return 0
        fi
    done
    return 1
}

# Auto-detect primary monitor (first non-ghost output)
detect_monitor_output() {
    local output
    output=$(hyprctl monitors 2>/dev/null | grep -oP '^Monitor \K\S+' | head -1 || echo "")
    if [[ -n "$output" ]]; then
        echo "$output"
        return 0
    fi
    return 1
}

# Auto-detect touch device name from hyprctl devices
detect_touch_device_name() {
    local in_touch_section=false
    while IFS= read -r line; do
        if [[ "$line" =~ ^Touch: ]]; then
            in_touch_section=true
            continue
        fi
        if [[ "$in_touch_section" == true ]]; then
            if [[ "$line" =~ ^[[:space:]]+Touch\ Device\ at ]]; then
                continue
            fi
            local name
            name=$(echo "$line" | sed 's/^[[:space:]]*//')
            if [[ -n "$name" && "$name" != *"-stylus"* ]]; then
                echo "$name"
                return 0
            fi
        fi
        if [[ "$in_touch_section" == true && "$line" =~ ^(Keyboards|Mice|Switches|Tablets): ]]; then
            break
        fi
    done <<< "$(hyprctl devices 2>/dev/null)"
    return 1
}

# Detect all devices
HINGE_DEVICE=$(detect_hinge_device) || { log "ERROR: No hinge sensor found"; exit 1; }
HINGE_ANGLE_PATH=$(detect_hinge_angle_path "$HINGE_DEVICE") || { log "ERROR: No hinge angle channel found"; exit 1; }
MONITOR_OUTPUT=$(detect_monitor_output) || { log "ERROR: No monitor found"; exit 1; }
TOUCH_DEVICE_NAME=$(detect_touch_device_name) || { log "WARNING: No touch device found, touch rotation disabled"; TOUCH_DEVICE_NAME=""; }

# Query current monitor transform so we don't force an unnecessary reconfiguration on startup.
# Falls back to "" (unknown) if hyprctl/jq are unavailable, which keeps the rotation eager.
current_transform=$(hyprctl -j monitors 2>/dev/null | jq -r ".[] | select(.name == \"$MONITOR_OUTPUT\") | .transform" 2>/dev/null || echo "")

log "Detected devices:"
log "  Hinge device: $HINGE_DEVICE"
log "  Hinge angle: $HINGE_ANGLE_PATH"
log "  Monitor: $MONITOR_OUTPUT"
log "  Touch device: ${TOUCH_DEVICE_NAME:-none}"

get_hinge_angle() {
    if [[ -f "$HINGE_ANGLE_PATH" ]]; then
        cat "$HINGE_ANGLE_PATH"
    else
        echo "0"
    fi
}

# Human-readable description of a transform: which screen edge rests on the
# ground/base. Matches monitor-sensor orientations.
#   0 normal     -> bottom edge on the base
#   1 left-up    -> right edge on the base (right points down)
#   2 bottom-up  -> top edge on the base
#   3 right-up   -> left edge on the base (left points down)
transform_desc() {
    local transform=$1
    case "$transform" in
        0) echo "bottom-base" ;;
        1) echo "right-base" ;;
        2) echo "top-base" ;;
        3) echo "left-base" ;;
        *) echo "transform-$transform" ;;
    esac
}

set_rotation() {
    local transform=$1
    # If current_transform is unknown (empty), force the rotation through once.
    if [[ -z "$current_transform" ]] || [[ "$transform" -ne "$current_transform" ]]; then
        log "Rotation: transform=$transform ($(transform_desc "$transform"))"

        # Map old/new transforms to compass sides for the bedding overlay.
        # Canonically 0:bottom, 1:right, 2:top, 3:left
        # but we will need to rotate current_transform to accomodate the rotated canvas perspective 
        local -a side_map=("bottom" "right" "top" "left")
        # In case current_transform is not valid
        local from_side="bottom"
        # From the rotated canvas perspective we always animate towards bottom edge
        local to_side="bottom"
        
        if [[ -n "$current_transform" ]]; then
            # the canvas will be rotated, so current_transform must be rotated so that it references 
            # the proper edge from the rotated canvas perspective
            current_transform=$(( (current_transform - transform + 4) % 4 ))
            from_side="${side_map[$current_transform]}"
        fi
        
        # Summon the bedding overlay (fire-and-forget, non-blocking).
        OMARCHY_PATH=/usr/share/omarchy omarchy-shell shell summon hyprbend.rotation \
            "{\"from\":\"$from_side\",\"to\":\"$to_side\",\"transform\":$transform,\"duration\":900}" \
            >/dev/null 2>&1 &

        # Wait a beat for the overlay to paint, then rotate.
        sleep 0.13

        local batch="eval hl.monitor({ output = \"${MONITOR_OUTPUT}\", transform = ${transform} })"
        if [[ -n "$TOUCH_DEVICE_NAME" ]]; then
            batch+=" ; eval hl.device({ name = \"${TOUCH_DEVICE_NAME}\", transform = ${transform} })"
        fi
        run_hyprctl hyprctl --batch "$batch"
        current_transform=$transform
    fi
}

orientation_monitor() {
    # monitor-sensor drives rotation directly; output is consumed here and
    # nothing raw is echoed. Job control is disabled (set +m at top) so bash
    # prints no "Done <pipeline>" noise when this job is stopped.
    monitor-sensor --accel 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *"normal"*)    set_rotation 0 ;;
            *"left-up"*)   set_rotation 1 ;;
            *"bottom-up"*) set_rotation 2 ;;
            *"right-up"*)  set_rotation 3 ;;
        esac
    done
}

# Start the orientation monitor once and leave it running permanently.
# It is never stopped on mode changes; rotations are gated by set_rotation().
# It is only torn down when hyprbend itself exits.
start_orientation_monitor() {
    orientation_monitor & disown
    monitor_sensor_pid=$!
    log "Orientation monitor started (PID: $monitor_sensor_pid)"
}

stop_orientation_monitor() {
    if [[ -n "$monitor_sensor_pid" ]] || pgrep -x monitor-sensor >/dev/null 2>&1; then
        pkill -x monitor-sensor 2>/dev/null || true
        monitor_sensor_pid=""
        log "Stopped orientation monitor"
    fi
}

switch_to_tablet() {
    if [[ "$current_mode" != "tablet" ]]; then
        log "Switching to tablet mode"
        current_mode="tablet"
    fi
}

switch_to_tent() {
    if [[ "$current_mode" != "tent" ]]; then
        log "Switching to tent mode"
        current_mode="tent"
    fi
}

switch_to_laptop() {
    if [[ "$current_mode" != "laptop" ]]; then
        log "Switching to laptop mode"
        current_mode="laptop"
        set_rotation 0
    fi
}

# Pre-flight sensor check
if command -v check_sensors_present &>/dev/null; then
    if ! check_sensors_present; then
        log "WARNING: No hinge/accelerometer IIO devices found"
        log "WARNING: Run 'hyprbend check' for diagnostics and fix instructions"
        log "WARNING: Continuing in degraded mode (no auto-rotation until sensors appear)"
    fi
fi

# Main loop
log "Starting hyprbend..."

# Start orientation monitor once; it runs for the lifetime of the service.
start_orientation_monitor

last_switch_time=$(date +%s%3N)

while true; do
    angle=$(get_hinge_angle)
    current_time=$(date +%s%3N)
    time_diff=$((current_time - last_switch_time))

    # Determine mode from angle: laptop < 180, tent < TABLET_ANGLE, else tablet.
    new_mode=""
    if [[ "$angle" -ge "$TABLET_ANGLE" ]]; then
        new_mode="tablet"
    elif [[ "$angle" -ge "$LAPTOP_TENT_BOUNDARY" ]]; then
        new_mode="tent"
    else
        new_mode="laptop"
    fi

    if [[ "$new_mode" != "$current_mode" ]] && [[ "$time_diff" -ge "$DEBOUNCE_DELAY" ]]; then
        case "$new_mode" in
            tablet) switch_to_tablet ;;
            tent)   switch_to_tent ;;
            laptop) switch_to_laptop ;;
        esac
        last_switch_time=$(date +%s%3N)
    fi

    sleep 0.1  # 10Hz polling
done
