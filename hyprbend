#!/bin/bash
# hyprbend - Automatic screen rotation and mode detection
# for 2-in-1 laptops running Hyprland / Omarchy
#
# Detects laptop/tent/tablet mode via hinge sensor or dual accelerometers and:
# - Rotates screen based on accelerometer orientation (in tent/tablet mode)
# - Rotates touch input to match
# - Summons the Omarchy hyprbend.rotation overlay animation
#
# Requires: hyprland, bash, jq, awk (optional: iio-sensor-proxy)

set -euo pipefail
# Disable job control so bash never prints "Done <pipeline>" async-job status
set +m

# Source shared detection library
_HYPRBEND_LIB_DIR="${HYPRBEND_LIB_DIR:-/usr/lib/hyprbend}"
_HYPRBEND_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _detect_candidate in \
    "${_HYPRBEND_BIN_DIR}/hyprbend-detect.sh" \
    "${_HYPRBEND_LIB_DIR}/detect.sh" \
    "/usr/lib/hyprbend/detect.sh"; do
    if [[ -f "$_detect_candidate" ]]; then
        # shellcheck source=hyprbend-detect.sh
        source "$_detect_candidate"
        break
    fi
done

# Subcommand dispatch: hyprbend check|fix|report|keyboard
if [[ "${1:-}" == "keyboard" ]]; then
    shift
    _kact="${1:-toggle}"
    case "$_kact" in
        open)   exec omarchy-shell hyprbend openKeyboard ;;
        close)  exec omarchy-shell hyprbend closeKeyboard ;;
        toggle) exec omarchy-shell hyprbend toggleKeyboard ;;
        state)  exec omarchy-shell hyprbend keyboardState ;;
        *)
            echo "Usage: hyprbend keyboard [open|close|toggle|state]" >&2
            exit 1
            ;;
    esac
fi

if [[ "${1:-}" =~ ^(check|fix|report)$ ]]; then
    _subcmd="${BASH_REMATCH[1]}"
    shift
    _BIN=""
    for candidate in \
        "${_HYPRBEND_BIN_DIR}/hyprbend-${_subcmd}" \
        "${HOME}/.local/bin/hyprbend-${_subcmd}" \
        "/usr/bin/hyprbend-${_subcmd}"; do
        if [[ -x "$candidate" ]]; then
            _BIN="$candidate"
            break
        fi
    done
    if [[ -z "$_BIN" ]]; then
        echo "[hyprbend] ERROR: hyprbend-${_subcmd} not found" >&2
        exit 1
    fi
    exec "$_BIN" "$@"
fi

# Physical reference anchors and mode boundaries (deg)
CLOSED_ANGLE=0                            # lid fully closed
LAPTOP_TENT_BOUNDARY="${LAPTOP_TENT_BOUNDARY:-180}" # < 180 = laptop, >= 180 = tent/tablet
TABLET_ANGLE="${TABLET_ANGLE:-310}"       # >= 310 = tablet (lid folded fully back)
DEBOUNCE_DELAY="${DEBOUNCE_DELAY:-250}"   # milliseconds to wait before mode switch
ROTATE_IN_LAPTOP_MODE="${ROTATE_IN_LAPTOP_MODE:-0}" # 0 = only auto-rotate in tent/tablet mode; 1 = always

# State
current_mode="unknown"
current_transform=""
last_sensor_transform=0
last_valid_angle=90
monitor_sensor_pid=""
MONITOR_FD=""

log() {
    echo "[hyprbend] $*" >&2
}

# Run a hyprctl command and tag any output with [hyprctl] for clean, attributed logs.
# Captures stdout+stderr; non-empty lines are logged, blank lines are dropped.
run_hyprctl() {
    local out line
    out=$("$@" 2>&1 || true)
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        log "[hyprctl] $line"
    done <<< "$out"
}

cleanup() {
    log "Shutting down..."
    stop_orientation_monitor
    if [[ -n "${TOUCH_DEVICE_NAME:-}" ]]; then
        run_hyprctl hyprctl eval "hl.device({ name = \"$TOUCH_DEVICE_NAME\", transform = 0 })"
    fi
    exit 0
}

trap cleanup SIGTERM SIGINT SIGHUP

# Auto-detect hinge IIO device
detect_hinge_device() {
    for dev in /sys/bus/iio/devices/iio:device*; do
        local name
        name=$(cat "$dev/name" 2>/dev/null || echo "")
        if [[ "$name" == "hinge" ]]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}

# Auto-detect the hinge/lid angle channel.
detect_hinge_angle_path() {
    local hinge_dev=$1
    [[ -n "$hinge_dev" && -d "$hinge_dev" ]] || return 1
    for label_file in "$hinge_dev"/in_angl*_label; do
        [[ -f "$label_file" ]] || continue
        local label
        label=$(cat "$label_file" 2>/dev/null || echo "")
        case "$label" in
            hinge|screen)
                echo "${label_file%_label}_raw"
                return 0
                ;;
        esac
    done
    # Degraded fallback: the "keyboard" channel (matches older/unlabeled sensors).
    for label_file in "$hinge_dev"/in_angl*_label; do
        [[ -f "$label_file" ]] || continue
        local label
        label=$(cat "$label_file" 2>/dev/null || echo "")
        if [[ "$label" == "keyboard" ]]; then
            echo "${label_file%_label}_raw"
            return 0
        fi
    done
    return 1
}

# Auto-detect primary screen accelerometer IIO device
detect_screen_accel_device() {
    for dev in /sys/bus/iio/devices/iio:device*; do
        [[ -d "$dev" ]] || continue
        if [[ -f "$dev/in_accel_x_raw" && -f "$dev/in_accel_y_raw" && -f "$dev/in_accel_z_raw" ]]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}

# Auto-detect primary monitor (first non-ghost output)
detect_monitor_output() {
    local output
    output=$(hyprctl monitors 2>/dev/null | grep -oP '^Monitor \K\S+' | head -1 || echo "")
    if [[ -n "$output" ]]; then
        echo "$output"
        return 0
    fi
    return 1
}

# Auto-detect touch device name from hyprctl devices
detect_touch_device_name() {
    local name
    name=$(hyprctl -j devices 2>/dev/null | jq -r '.touch[]?.name // empty' 2>/dev/null | grep -v -- '-stylus$' | head -1 || echo "")
    if [[ -n "$name" ]]; then
        echo "$name"
        return 0
    fi
    local in_touch_section=false
    while IFS= read -r line; do
        if [[ "$line" =~ ^Touch: ]]; then
            in_touch_section=true
            continue
        fi
        if [[ "$in_touch_section" == true ]]; then
            if [[ "$line" =~ ^[[:space:]]+Touch\ Device\ at ]]; then
                continue
            fi
            name=$(echo "$line" | sed 's/^[[:space:]]*//')
            if [[ -n "$name" && "$name" != *"-stylus"* ]]; then
                echo "$name"
                return 0
            fi
        fi
        if [[ "$in_touch_section" == true && "$line" =~ ^(Keyboards|Mice|Switches|Tablets): ]]; then
            break
        fi
    done <<< "$(hyprctl devices 2>/dev/null)"
    return 1
}

# Detect all devices
HINGE_DEVICE=$(detect_hinge_device || echo "")
HINGE_ANGLE_PATH=""
if [[ -n "$HINGE_DEVICE" ]]; then
    HINGE_ANGLE_PATH=$(detect_hinge_angle_path "$HINGE_DEVICE" || echo "")
fi

ACCEL_SCREEN_DEV=""
ACCEL_BASE_DEV=""
if command -v detect_dual_accel_devices &>/dev/null; then
    _dual=$(detect_dual_accel_devices || echo "")
    if [[ -n "$_dual" ]]; then
        read -r ACCEL_SCREEN_DEV ACCEL_BASE_DEV <<< "$_dual"
    fi
fi
if [[ -z "$ACCEL_SCREEN_DEV" ]]; then
    ACCEL_SCREEN_DEV=$(detect_screen_accel_device || echo "")
fi

if [[ -z "$HINGE_ANGLE_PATH" && -z "$ACCEL_BASE_DEV" ]]; then
    log "ERROR: Neither hinge sensor nor dual accelerometers found"
    exit 1
fi

MONITOR_OUTPUT=$(detect_monitor_output) || { log "ERROR: No monitor found"; exit 1; }
TOUCH_DEVICE_NAME=$(detect_touch_device_name) || { log "WARNING: No touch device found, touch rotation disabled"; TOUCH_DEVICE_NAME=""; }
TABLET_SWITCH_NAME=""
if command -v detect_tablet_mode_switch &>/dev/null; then
    TABLET_SWITCH_NAME=$(detect_tablet_mode_switch || echo "")
fi

# Query current monitor transform so we don't force an unnecessary reconfiguration on startup.
current_transform=$(hyprctl -j monitors 2>/dev/null | jq -r ".[] | select(.name == \"$MONITOR_OUTPUT\") | .transform" 2>/dev/null || echo "")

log "Detected devices:"
log "  Hinge device: ${HINGE_DEVICE:-none}"
log "  Hinge angle path: ${HINGE_ANGLE_PATH:-none}"
log "  Screen accelerometer: ${ACCEL_SCREEN_DEV:-none}"
log "  Base accelerometer: ${ACCEL_BASE_DEV:-none}"
log "  Tablet mode switch: ${TABLET_SWITCH_NAME:-none}"
log "  Monitor: $MONITOR_OUTPUT"
log "  Touch device: ${TOUCH_DEVICE_NAME:-none}"

get_hinge_angle() {
    local prev_angle="${1:-$last_valid_angle}"
    local raw_angle="0"
    if [[ -n "$HINGE_ANGLE_PATH" && -f "$HINGE_ANGLE_PATH" ]]; then
        raw_angle=$(cat "$HINGE_ANGLE_PATH" 2>/dev/null || echo "0")
    fi

    # Many Lenovo/Intel ISH convertibles (e.g. IdeaPad Flex 5) expose a hinge IIO device
    # whose raw value stays 0, while providing dual 3D accelerometers (screen + base).
    if [[ "$raw_angle" != "0" && -n "$raw_angle" ]]; then
        echo "$raw_angle"
        return 0
    fi

    if [[ -n "$ACCEL_SCREEN_DEV" && -n "$ACCEL_BASE_DEV" ]] && command -v compute_dual_accel_hinge_angle &>/dev/null; then
        local calc_angle
        if calc_angle=$(compute_dual_accel_hinge_angle "$ACCEL_SCREEN_DEV" "$ACCEL_BASE_DEV"); then
            if [[ -n "$calc_angle" ]]; then
                # When folded completely flat back-to-back (~360°), slight sensor tolerance
                # can wrap 359° -> 0°..24°. If we were already folded past 180° and the
                # ACPI lid switch still reports open, clamp to 360° (tablet mode).
                if (( calc_angle < 25 && prev_angle >= 180 )); then
                    if ! grep -qi "closed" /proc/acpi/button/lid/*/state 2>/dev/null; then
                        calc_angle=360
                    fi
                fi
                echo "$calc_angle"
                return 0
            fi
        fi
    fi

    echo "$prev_angle"
}

# Read screen orientation directly from the screen IIO accelerometer when monitor-sensor
# is unavailable or inactive. Uses hysteresis around 45-degree diagonals to avoid thrashing.
poll_direct_accel_orientation() {
    [[ -n "$ACCEL_SCREEN_DEV" && -f "$ACCEL_SCREEN_DEV/in_accel_x_raw" ]] || return 1

    awk -v dev="$ACCEL_SCREEN_DEV" -v cur="${last_sensor_transform:-0}" '
    BEGIN {
        if ((getline x < (dev "/in_accel_x_raw")) <= 0) exit 1
        if ((getline y < (dev "/in_accel_y_raw")) <= 0) exit 1

        ax = (x < 0) ? -x : x
        ay = (y < 0) ? -y : y

        # Require at least ~4.4 m/s^2 in the screen XY plane and 1.35x dominance for hysteresis
        min_mag = 450000
        ratio = 1.35

        if (ay > min_mag && ay > ax * ratio) {
            if (y < 0) print 0      # normal (bottom-base)
            else       print 2      # bottom-up (top-base)
        } else if (ax > min_mag && ax > ay * ratio) {
            if (x > 0) print 1      # left-up (right-base)
            else       print 3      # right-up (left-base)
        } else {
            print cur
        }
    }' 2>/dev/null
}

# Human-readable description of a transform: which screen edge rests on the
# ground/base. Matches monitor-sensor orientations.
#   0 normal     -> bottom edge on the base
#   1 left-up    -> right edge on the base (right points down)
#   2 bottom-up  -> top edge on the base
#   3 right-up   -> left edge on the base (left points down)
transform_desc() {
    local transform=$1
    case "$transform" in
        0) echo "bottom-base" ;;
        1) echo "right-base" ;;
        2) echo "top-base" ;;
        3) echo "left-base" ;;
        *) echo "transform-$transform" ;;
    esac
}

set_rotation() {
    local transform=$1
    # If current_transform is unknown (empty), force the rotation through once.
    if [[ -z "$current_transform" ]] || [[ "$transform" -ne "$current_transform" ]]; then
        log "Rotation: transform=$transform ($(transform_desc "$transform")) [mode=$current_mode]"

        # Map old/new transforms to compass sides for the bedding overlay.
        # Canonically 0:bottom, 1:right, 2:top, 3:left
        local -a side_map=("bottom" "right" "top" "left")
        local from_side="bottom"
        local to_side="bottom"

        if [[ -n "$current_transform" && "$current_transform" =~ ^[0-3]$ ]]; then
            local rel_idx=$(( (current_transform - transform + 4) % 4 ))
            from_side="${side_map[$rel_idx]}"
        fi

        # Summon the bedding overlay (fire-and-forget, non-blocking).
        OMARCHY_PATH=/usr/share/omarchy omarchy-shell shell summon hyprbend.rotation \
            "{\"from\":\"$from_side\",\"to\":\"$to_side\",\"transform\":$transform,\"duration\":900}" \
            >/dev/null 2>&1 &

        # Wait a beat for the overlay to paint, then rotate.
        sleep 0.13

        local batch="eval hl.monitor({ output = \"${MONITOR_OUTPUT}\", transform = ${transform} })"
        if [[ -n "$TOUCH_DEVICE_NAME" ]]; then
            batch+=" ; eval hl.device({ name = \"${TOUCH_DEVICE_NAME}\", transform = ${transform} })"
        fi
        run_hyprctl hyprctl --batch "$batch"
        current_transform=$transform
    fi
}

apply_orientation_if_allowed() {
    local target_transform=$1
    last_sensor_transform=$target_transform
    if [[ "$current_mode" == "tablet" || "$current_mode" == "tent" || "$ROTATE_IN_LAPTOP_MODE" == "1" ]]; then
        set_rotation "$target_transform"
    fi
}

start_orientation_monitor() {
    if command -v monitor-sensor &>/dev/null && systemctl is-active iio-sensor-proxy.service &>/dev/null; then
        exec 3< <(monitor-sensor --accel 2>/dev/null)
        monitor_sensor_pid=$!
        MONITOR_FD=3
        log "Orientation monitor started via monitor-sensor (PID: $monitor_sensor_pid)"
    else
        MONITOR_FD=""
        if init_orient=$(poll_direct_accel_orientation); then
            [[ -n "$init_orient" ]] && last_sensor_transform="$init_orient"
        fi
        log "Using direct IIO accelerometer orientation polling (${ACCEL_SCREEN_DEV})"
    fi
}

stop_orientation_monitor() {
    if [[ -n "${MONITOR_FD:-}" ]]; then
        exec 3<&- 2>/dev/null || true
        exec 4<&- 2>/dev/null || true
        MONITOR_FD=""
    fi
    if [[ -n "$monitor_sensor_pid" ]]; then
        kill "$monitor_sensor_pid" 2>/dev/null || true
        monitor_sensor_pid=""
        log "Stopped orientation monitor"
    fi
}

switch_to_tablet() {
    if [[ "$current_mode" != "tablet" ]]; then
        log "Switching to tablet mode (angle=${angle}°)"
        current_mode="tablet"
        OMARCHY_PATH=/usr/share/omarchy omarchy-shell -q hyprbend setMode tablet >/dev/null 2>&1 &
        set_rotation "$last_sensor_transform"
    fi
}

switch_to_tent() {
    if [[ "$current_mode" != "tent" ]]; then
        log "Switching to tent mode (angle=${angle}°)"
        current_mode="tent"
        OMARCHY_PATH=/usr/share/omarchy omarchy-shell -q hyprbend setMode tent >/dev/null 2>&1 &
        set_rotation "$last_sensor_transform"
    fi
}

switch_to_laptop() {
    if [[ "$current_mode" != "laptop" ]]; then
        log "Switching to laptop mode (angle=${angle}°)"
        current_mode="laptop"
        OMARCHY_PATH=/usr/share/omarchy omarchy-shell -q hyprbend setMode laptop >/dev/null 2>&1 &
        if [[ "$ROTATE_IN_LAPTOP_MODE" != "1" ]]; then
            set_rotation 0
        fi
    fi
}

# Pre-flight sensor check
if command -v check_sensors_present &>/dev/null; then
    if ! check_sensors_present; then
        log "WARNING: No hinge/accelerometer IIO devices found"
        log "WARNING: Run 'hyprbend check' for diagnostics and fix instructions"
        log "WARNING: Continuing in degraded mode (no auto-rotation until sensors appear)"
    fi
fi

# Main loop
log "Starting hyprbend..."

start_orientation_monitor

last_switch_time=${EPOCHREALTIME/./}
last_switch_time=${last_switch_time:0:13}

# If python3 is available and we are using direct IIO polling, run a single zero-fork
# sensor polling stream so we don't spawn subshells/awk processes 10 times per second.
if [[ -z "$MONITOR_FD" ]] && command -v python3 &>/dev/null; then
    exec 4< <(python3 -u - "$HINGE_ANGLE_PATH" "$ACCEL_SCREEN_DEV" "$ACCEL_BASE_DEV" <<'PYEOF'
import math, sys, time, glob

hinge_path, screen_dev, base_dev = sys.argv[1], sys.argv[2], sys.argv[3]
last_angle = 90
last_orient = 0
prev_emitted = None

def read_int(path):
    try:
        with open(path, "r") as f:
            return int(f.read().strip())
    except Exception:
        return None

def lid_closed():
    for p in glob.glob("/proc/acpi/button/lid/*/state"):
        try:
            with open(p, "r") as f:
                if "closed" in f.read().lower():
                    return True
        except Exception:
            pass
    return False

while True:
    # 1. Hinge angle
    angle = None
    if hinge_path:
        raw = read_int(hinge_path)
        if raw is not None and raw != 0:
            angle = raw

    if angle is None and screen_dev and base_dev:
        y0 = read_int(f"{screen_dev}/in_accel_y_raw")
        z0 = read_int(f"{screen_dev}/in_accel_z_raw")
        y1 = read_int(f"{base_dev}/in_accel_y_raw")
        z1 = read_int(f"{base_dev}/in_accel_z_raw")
        if None not in (y0, z0, y1, z1):
            r0 = math.hypot(y0, z0)
            r1 = math.hypot(y1, z1)
            if r0 >= 250000 and r1 >= 250000:
                a0 = math.degrees(math.atan2(y0, z0))
                a1 = math.degrees(math.atan2(y1, z1))
                calc = int((a1 - a0 - 180.0) % 360.0 + 0.5) % 360
                if calc < 25 and last_angle >= 180 and not lid_closed():
                    calc = 360
                angle = calc

    if angle is not None:
        last_angle = angle
    else:
        angle = last_angle

    # 2. Screen orientation
    if screen_dev:
        x = read_int(f"{screen_dev}/in_accel_x_raw")
        y = read_int(f"{screen_dev}/in_accel_y_raw")
        if x is not None and y is not None:
            ax, ay = abs(x), abs(y)
            if ay > 450000 and ay > ax * 1.35:
                last_orient = 0 if y < 0 else 2
            elif ax > 450000 and ax > ay * 1.35:
                last_orient = 1 if x > 0 else 3

    print(f"{angle} {last_orient}", flush=True)
    time.sleep(0.1)
PYEOF
    )
    monitor_sensor_pid=$!
    MONITOR_FD=4
fi

while true; do
    if [[ "$MONITOR_FD" == "4" ]]; then
        IFS=' ' read -r angle new_orient <&4 || break
        last_valid_angle="$angle"
        if [[ -n "$new_orient" && "$new_orient" != "$last_sensor_transform" ]]; then
            apply_orientation_if_allowed "$new_orient"
        fi
    else
        # 1. Read orientation updates (either from monitor-sensor FD or direct IIO accelerometer)
        if [[ -n "$MONITOR_FD" ]]; then
            if IFS= read -r -t 0.1 -u 3 line; then
                case "$line" in
                    *"normal"*)    apply_orientation_if_allowed 0 ;;
                    *"left-up"*)   apply_orientation_if_allowed 1 ;;
                    *"bottom-up"*) apply_orientation_if_allowed 2 ;;
                    *"right-up"*)  apply_orientation_if_allowed 3 ;;
                esac
            fi
        else
            if new_orient=$(poll_direct_accel_orientation); then
                if [[ -n "$new_orient" && "$new_orient" != "$last_sensor_transform" ]]; then
                    apply_orientation_if_allowed "$new_orient"
                fi
            fi
            sleep 0.1
        fi

        # 2. Read hinge angle and update laptop / tent / tablet mode
        angle=$(get_hinge_angle "$last_valid_angle")
        last_valid_angle="$angle"
    fi

    current_time=${EPOCHREALTIME/./}
    current_time=${current_time:0:13}
    time_diff=$((current_time - last_switch_time))

    # Determine mode from angle: laptop < 180, tent < TABLET_ANGLE, else tablet.
    new_mode=""
    if [[ "$angle" -ge "$TABLET_ANGLE" ]]; then
        new_mode="tablet"
    elif [[ "$angle" -ge "$LAPTOP_TENT_BOUNDARY" ]]; then
        new_mode="tent"
    else
        new_mode="laptop"
    fi

    if [[ "$new_mode" != "$current_mode" ]] && [[ "$time_diff" -ge "$DEBOUNCE_DELAY" ]]; then
        case "$new_mode" in
            tablet) switch_to_tablet ;;
            tent)   switch_to_tent ;;
            laptop) switch_to_laptop ;;
        esac
        last_switch_time="$current_time"
    fi
done
