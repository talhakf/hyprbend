#!/bin/bash
# hyprbend-fix — Auto-fix sensor setup for 2-in-1 laptops
#
# Attempts to fix firmware, driver, and service issues.
# On failure, offers to generate a GitHub issue report.

set -euo pipefail

# --- Find detect library ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DETECT_SH=""
for candidate in \
    "${SCRIPT_DIR}/hyprbend-detect.sh" \
    "${SCRIPT_DIR}/../lib/hyprbend/detect.sh" \
    "/usr/lib/hyprbend/detect.sh"; do
    if [[ -f "$candidate" ]]; then
        DETECT_SH="$candidate"
        break
    fi
done

if [[ -z "$DETECT_SH" ]]; then
    echo "[hyprbend-fix] ERROR: Cannot find hyprbend-detect.sh" >&2
    exit 1
fi
# shellcheck source=hyprbend-detect.sh
source "$DETECT_SH"

# --- Colors ---

if [[ -t 1 ]]; then
    C_GREEN="\033[0;32m"
    C_RED="\033[0;31m"
    C_YELLOW="\033[0;33m"
    C_CYAN="\033[0;36m"
    C_BOLD="\033[1m"
    C_RESET="\033[0m"
else
    C_GREEN="" C_RED="" C_YELLOW="" C_CYAN="" C_BOLD="" C_RESET=""
fi

pass()   { echo -e "  ${C_GREEN}✓${C_RESET} $*" >&2; }
fail()   { echo -e "  ${C_RED}✗${C_RESET} $*" >&2; }
warn()   { echo -e "  ${C_YELLOW}⚠${C_RESET} $*" >&2; }
info()   { echo -e "  ${C_CYAN}i${C_RESET} $*" >&2; }
header() { echo -e "\n${C_BOLD}$*${C_RESET}" >&2; }

# --- Firmware installer ---

# Downloads, extracts, and installs ISH firmware from vendor driver packages.
# Uses resolve_firmware() from hyprbend-detect.sh to look up the correct package.
# Returns: 0 if firmware installed, 1 if resolver not found or install failed
install_ish_firmware() {
    local gen sys_vendor device_id pci_addr
    gen=$(detect_ish_gen) || { return 1; }
    sys_vendor=$(read_dmi sys_vendor)

    pci_addr=$(lspci -Dnn 2>/dev/null | grep -i 'Integrated Sensor Hub' | head -1 | awk '{print $1}' || echo "")
    if [[ -z "$pci_addr" ]]; then
        pci_addr=$(find /sys/bus/pci/devices/ -name vendor -exec sh -c '
            Vendor=$(cat "$1")
            DevClass=$(cat "$(dirname "$1")/class" 2>/dev/null)
            [[ "$Vendor" == "0x8086" && ("$DevClass" == "0x070000" || "$DevClass" == "0x088000") ]]
            && basename "$(dirname "$1")"
        ' _ {} \; 2>/dev/null | head -1 || echo "")
    fi
    device_id=$(cat "/sys/bus/pci/devices/${pci_addr}/device" 2>/dev/null || echo "")
    device_id=${device_id#0x}

    # Resolve firmware package
    if ! resolve_firmware "$sys_vendor" "$gen" "$device_id"; then
        return 1
    fi

    header "Auto-fix: ISH Firmware (${sys_vendor})"

    # Check for 7z
    if ! command -v 7z &>/dev/null; then
        fail "7zip not found. Install: sudo pacman -S 7zip"
        return 1
    fi

    local work_dir="/tmp/hyprbend-ish-firmware"
    local fw_dest="/usr/lib/firmware/intel/ish/${FIRMWARE_TARGET}"
    local pkg_name
    pkg_name=$(basename "$FIRMWARE_URL")

    rm -rf "$work_dir"
    mkdir -p "$work_dir"

    # Download
    info "Downloading ${pkg_name}..."
    if ! curl -L --progress-bar -o "${work_dir}/${pkg_name}" "$FIRMWARE_URL" 2>&2; then
        fail "Download failed. Check network."
        rm -rf "$work_dir"
        return 1
    fi

    # Extract
    info "Extracting..."
    cd "$work_dir"
    7z x -y "$pkg_name" -oextracted >/dev/null 2>&1 || {
        fail "Extraction failed."
        rm -rf "$work_dir"
        return 1
    }

    # Find firmware file — search in IshHeciExtensionTemplate/FWImage/0003/ first,
    # then fall back to any IshHeciExtensionTemplate/**/ path
    local fw_src=""
    fw_src=$(find extracted -path "*/IshHeciExtensionTemplate/FWImage/0003/${FIRMWARE_FW_PATTERN}" -type f 2>/dev/null | head -1 || echo "")
    if [[ -z "$fw_src" ]]; then
        fw_src=$(find extracted -path "*/IshHeciExtensionTemplate/*/${FIRMWARE_FW_PATTERN}" -type f 2>/dev/null | head -1 || echo "")
    fi
    if [[ -z "$fw_src" ]]; then
        fw_src=$(find extracted -name "${FIRMWARE_FW_PATTERN}" -path "*/FWImage/*" -type f 2>/dev/null | head -1 || echo "")
    fi

    if [[ -z "$fw_src" || ! -f "$fw_src" ]]; then
        fail "Firmware matching '${FIRMWARE_FW_PATTERN}' not found in package."
        info "Expected in: IshHeciExtensionTemplate/FWImage/0003/"
        fail "Check your vendor's ISH driver package."
        rm -rf "$work_dir"
        return 1
    fi

    local fw_size
    fw_size=$(stat -c%s "$fw_src" 2>/dev/null)

    sudo cp "$fw_src" "$fw_dest"
    pass "Firmware installed: ${FIRMWARE_TARGET} (${fw_size} bytes)"

    info "Rebuilding initramfs..."
    if command -v limine-mkinitcpio &>/dev/null; then
        sudo limine-mkinitcpio >&2
    elif command -v mkinitcpio &>/dev/null; then
        sudo mkinitcpio -P >&2
    fi

    rm -rf "$work_dir"
    return 0
}

# --- Fix logic ---

fix_firmware() {
    local platform=$1
    local changes=0
    header "Fix: Firmware"

    if [[ "$platform" != "intel_ish" ]]; then
        if [[ "$platform" == "amd_sfh" ]]; then
            info "AMD SFH does not need firmware — checking kernel module..."
            if ! lsmod 2>/dev/null | grep -q amd_sfh; then
                info "Loading amd_sfh module..."
                if sudo modprobe amd_sfh_hid 2>/dev/null; then
                    pass "amd_sfh_hid loaded"
                    changes=$((changes + 1))
                else
                    warn "Could not load amd_sfh_hid"
                fi
            else
                pass "amd_sfh module already loaded"
            fi
        else
            fail "No Intel ISH or AMD SFH detected — firmware fix not applicable"
        fi
        echo "$changes"
        return
    fi

    # Check if linux-firmware is installed
    if pacman -Qi linux-firmware &>/dev/null 2>&1; then
        pass "linux-firmware is installed"
    else
        warn "linux-firmware not installed"
        info "Installing linux-firmware..."
        if sudo pacman -S --noconfirm linux-firmware-intel 2>/dev/null; then
            pass "linux-firmware-intel installed"
            changes=$((changes + 1))
        else
            fail "Failed to install linux-firmware-intel"
        fi
        echo "$changes"
        return
    fi

    # Check if firmware files exist
    check_ish_firmware
    local all_found=true
    for status in "${ISH_FIRMWARE_STATUS[@]}"; do
        if [[ "$status" == "missing" ]]; then
            all_found=false
            break
        fi
    done

    if $all_found; then
        pass "All expected firmware files present"
        echo "$changes"
        return
    fi

    # Firmware is missing — try fwupd
    if command -v fwupdmgr &>/dev/null; then
        info "Attempting firmware update via fwupd..."
        if sudo fwupdmgr refresh --force 2>/dev/null && sudo fwupdmgr get-updates 2>/dev/null; then
            if sudo fwupdmgr update --no-reboot-check 2>/dev/null; then
                pass "fwupd firmware update completed"
                changes=$((changes + 1))
                echo "$changes"
                return
            else
                warn "fwupd update did not resolve the issue"
            fi
        else
            warn "No firmware updates available via fwupd"
        fi
    else
        warn "fwupd not installed"
    fi

    # Try firmware resolver
    if install_ish_firmware; then
        changes=$((changes + 1))
    else
        # No resolver — manual instructions
        local gen sys_vendor
        gen=$(detect_ish_gen)
        sys_vendor=$(read_dmi sys_vendor)

        header "Manual Firmware Instructions"
        info "Your device: ${sys_vendor} (ISH gen: ${gen})"
        echo ""
        info "Vendor-specific ISH firmware may be needed. Try:"
        info "  1. Check your vendor's Linux support page"
        info "  2. Extract firmware from Windows ISH driver packages"
        info "     (look for 'IshHeciExtensionTemplate' directory)"
        info "  3. Place the .bin file in /lib/firmware/intel/ish/"
        info "  4. Rebuild initramfs and reboot"
        echo ""
        info "Reference: https://docs.kernel.org/hid/intel-ish-hid.html"
    fi

    echo "$changes"
}

fix_services() {
    local changes=0
    header "Fix: Services"

    if ! check_iio_sensor_proxy; then
        info "Enabling iio-sensor-proxy..."
        if sudo systemctl enable --now iio-sensor-proxy 2>/dev/null; then
            pass "iio-sensor-proxy enabled"
            changes=$((changes + 1))
        else
            warn "Could not enable iio-sensor-proxy"
        fi
    else
        pass "iio-sensor-proxy already running"
    fi

    echo "$changes"
}

# --- Main ---

main() {
    echo -e "${C_BOLD}hyprbend-fix${C_RESET} — Auto-fix sensor setup for 2-in-1 laptops" >&2
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2

    local platform
    platform=$(detect_platform) || true

    case "$platform" in
        intel_ish)  info "Platform: Intel ISH (gen: $(detect_ish_gen))" ;;
        amd_sfh)    info "Platform: AMD SFH" ;;
        none)       info "Platform: none detected" ;;
    esac

    local fw_changes svc_changes
    fw_changes=$(fix_firmware "$platform")
    svc_changes=$(fix_services)

    local total_changes=$((fw_changes + svc_changes))

    echo "" >&2
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2

    if [[ "$total_changes" -gt 0 ]]; then
        warn "Reboot recommended for changes to take effect"
    else
        pass "No changes needed — system appears correctly configured"
    fi

    # If nothing was fixed and platform is broken, offer report
    if [[ "$total_changes" -eq 0 && "$platform" == "none" ]]; then
        echo "" >&2
        info "Auto-fix could not resolve platform detection."
        if [[ -t 0 ]]; then
            read -rp "Print GitHub issue report? [Y/n] " answer >&2
            answer="${answer:-Y}"
        else
            answer="Y"
        fi
        if [[ "${answer,,}" == "y" ]]; then
            echo "" >&2
            report_github_issue
        fi
    elif [[ "$total_changes" -eq 0 && "$platform" == "intel_ish" ]]; then
        # Check if firmware was partially found
        check_ish_firmware 2>/dev/null || true
        local has_missing=false
        for status in "${ISH_FIRMWARE_STATUS[@]:-}"; do
            if [[ "$status" == "missing" ]]; then
                has_missing=true
                break
            fi
        done
        if $has_missing; then
            echo "" >&2
            info "Some firmware files are missing and could not be auto-fixed."
            if [[ -t 0 ]]; then
                read -rp "Print GitHub issue report? [Y/n] " answer >&2
                answer="${answer:-Y}"
            else
                answer="Y"
            fi
            if [[ "${answer,,}" == "y" ]]; then
                echo "" >&2
                report_github_issue
            fi
        fi
    fi
}

main
